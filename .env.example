# Logging level: INFO | DEBUG | WARNING
LOGGING=INFO

# HTTP listen port (defaults to 8000 if unset)
PORT=8000

# IANA timezone used to render every reported timestamp
TIME_ZONE=America/Mexico_City

# MongoDB connection
MONGO_URL=127.0.0.1
MONGO_PORT=27017
MONGO_ACCOUNT_DB=mathematics
MONGO_VARIABLES_COLLECTION=variables
MONGO_JOBS_COLLECTION=jobs

# Redis connection (used for cross-worker job-dependency signaling)
REDIS_URL=redis://localhost:6379/0

# Directory (relative to the repository root, or absolute) holding immutable job scripts
IMMUTABLE_JOBS_DIR=jobs/immutable
